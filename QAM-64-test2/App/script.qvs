"IC Issue":
left keep
LOAD "Invoice_Collection_Issue_Log_Id" AS 'IC Issue Id',
	"Invoice_Collection_Activity_Id" AS 'Issue Id',
    "Account_Invoice_Collection_Month_Id" AS %Account_Invoice_Collection_Month_Id,
    if(Issue_Status='Close','Resolved',Issue_Status) as [Issue Status],
    //Issue_Status,
    "Issue_Entity_Owner" as [Issue Owner],
    //"Issue_Owner_User_Id" AS %Issue_Owner_User_Id,
    "Type_Of_Issue_Owner",
    "Esclation_Dt",
    "Resolution_Dt",
    "Issue_Type" as [Issue Type],
    date("Missing_Period_Start_Dt",'DD MMM YYYY') as Missing_Period_Start_Dt,
    date("Missing_Period_End_Dt",'DD MMM YYYY') as Missing_Period_End_Dt,
    "Issue_Comment",
    Issue_Sub_Type as [Issue Sub Type],
    //if(Issue_Report_Status='Esclated','Escalated',Issue_Report_Status) as [Issue Category]
    //	https://summit.jira.com/browse/BI-1319		// wait to implement // not dev tested.
    if(Issue_Report_Status='Esclated' or (isnull(Issue_Sub_Type) and isnull(Issue_Report_Status)),'Escalated',Issue_Report_Status) as [Issue Category]
FROM  [$(v_RA_QVD_Client_Connection)\IC_Issue.qvd](qvd);
concatenate([IC Issue]) load ' ' as [Issue Status] autogenerate 1; // BI-1762 This prevents "Billing Periods Affected" KPI set analysis from showing all records when the Issue Status is 100% null (new config) 





///$tab Services
/***********************************************************************************************************************************************
"Services"

Note1: In case of emission enable below fields
Client_Commodity_Id, Scope

Note2: below fields used in case of Cost&Usage detail level report
Is_Shown_on_Site,Is_Shown_On_Account,Is_Shown_On_Invoice,UOM_Entity_Type 
***********************************************************************************************************************************************/
Services:
LOAD Distinct
    Commodity_Id as %Commodity_Id,
    Bucket_Master_Id as %Bucket_Master_Id ,
    Commodity_Name as 'Service'    
FROM [$(v_RA_QVD_Client_Connection)\Commodity_Bucket_Master.qvd](qvd);
//	QQ: 2022-02-17	ACC Why are we loading the field Bucket_Master_Id when we are not actually utilizing before dropping the table directly below?

"Account_Services":
LOAD distinct
    Account_Id AS [%Account_Id]
    ,Commodity_Id AS [%Commodity_Id]
FROM [$(v_RA_QVD_Client_Connection)\Account_Commodity.qvd] (qvd);
INNER JOIN LOAD %Account_Id AS [%Account_Id]
Resident "Security Account";
INNER JOIN LOAD    
    %Commodity_Id,
    	Service
Resident Services;

drop table Services;


/**********************************************************************************************************************************************
	This table gets all the account services in a comma separated format
**********************************************************************************************************************************************/

"Account_Commodity_CSV":
LOAD 
	%Account_Id
    ,Concat(DISTINCT Service,', ') AS Account_Service_All
Resident Account_Services
GROUP BY [%Account_Id];

/**********************************************************************************************************************************************
Below line can be commented out if we do not require to show the each commodity of an account in a separate line
**********************************************************************************************************************************************/
//DROP TABLE Account_Services;
///$tab Calendar
[Client Name]:
FIRST 1 LOAD [Client Name] as [Client]
FROM [$(v_RA_QVD_Global_Connection)/Client_Info.qvd](qvd)
WHERE Client_Id = '$(v_ClientId)';

Let v_ClientName = Peek('Client', -1, 'Client Name');

//	Determine the Fiscal Year Offset
[ClientFiscalOffset]:
load Distinct Client_Fiscal_Offset From  [$(v_RA_QVD_Client_Connection)/SiteGroup_Site_Security_Role_Client_Hier.qvd](qvd);
	
if NoOfRows('ClientFiscalOffset') = 0 THEN
   	Load Distinct Client_Fiscal_Offset From  [$(v_RA_QVD_Client_Connection)/SiteGroup_Site_Security_Role_Client_Hier.qvd](qvd);
End if;

LET v_Client_Fiscal_Offset = Peek('Client_Fiscal_Offset');
LET v_CurrentFiscalYear = Year(YearEnd(Today(), 0, Mod( $(v_Client_Fiscal_Offset), 12) + 1)) ;

Join Load $(v_CurrentFiscalYear) as [%Current Fiscal Year] AutoGenerate(1);

/***********************************************************************************************************************************************
"Calendar"
***********************************************************************************************************************************************/
date_range:
load max(%Service_Month_Id) as max_date
	,min(%Service_Month_Id) as min_date
resident [IC Record Status];

let v_max_date	=	peek('max_date',0,'date_range');
trace v_max_date	=	$(v_max_date);
let v_min_date	=	peek('min_date',0,'date_range');
trace v_min_date	=	$(v_min_date);
let v_min_date_add_13	=	addmonths($(v_min_date),13);
trace v_min_date_add_13	=	$(v_min_date_add_13);

Calendar:
LOAD
    Service_Month_Id as %Service_Month_Id
    ,date(Service_Month,'DD MMM YYYY') as 'Service Month'
    ,date(Service_Month,'MMM YYYY') as Service_Month_Format
    ,Year_Number as 'Year'
    ,Month_Name as 'Month'
    //,Year(YearEnd(Service_Month_Id, 0, Mod(  $(v_Client_Fiscal_Offset), 12))) as [Fiscal Year] 
    ,Year(YearEnd(Service_Month, 0, Mod(  $(v_Client_Fiscal_Offset), 12) + 1)) as [Fiscal Year] 
    ,if(Service_Month>=addmonths($(v_current_chase_date),-12) and Service_Month<=$(v_current_chase_date)
    	,1,0) as Current_13_Flag
    ,if(Service_Month>=addmonths($(v_current_chase_date),-1) and Service_Month<=$(v_current_chase_date)
    	,1,0) as Current_Full_Month_Flag
    //,if(Service_Month_Id>=addmonths($(v_current_chase_date),-12) and Service_Month_Id<=$(v_current_chase_date)
    //	,1,0) as Current_13_Flag
    //,if(Service_Month_Id>=addmonths($(v_current_chase_date),-1) and Service_Month_Id<=$(v_current_chase_date)
    //	,1,0) as Current_Full_Month_Flag
    //,if(Service_Month_Id>=addmonths($(v_max_date),-12) and Service_Month_Id<=$(v_max_date)
    //	,1,0) as Current_13_Flag
    //,if(Service_Month_Id>=addmonths($(v_max_date),-1) and Service_Month_Id<=$(v_max_date)
    //	,1,0) as Current_Full_Month_Flag
FROM [$(v_RA_QVD_Global_Connection)\Date_Dim.qvd](qvd)
where Service_Month_Id >= $(v_min_date) and Service_Month_Id <= $(v_max_date);

temp_M2_AsOf:
load distinct [Service Month] as [M-2 Month] resident Calendar
where [Service Month] >= '$(v_min_date_add_13)';
join load distinct [Service Month] resident Calendar;

M2_AsOf:
noconcatenate
load [M-2 Month]
	,[Service Month]
	,date([M-2 Month],'MMM YY') & ': ' & date(addmonths([M-2 Month],-13),'MMM YY') & ' to ' & date(addmonths([M-2 Month],-2),'MMM YY') as [M-2 Range]
resident temp_M2_AsOf
where [Service Month] >= addmonths([M-2 Month],-13) and [Service Month] <= addmonths([M-2 Month],-2)
order by [M-2 Month] asc;
drop table temp_M2_AsOf;

// Variable must be from Highest Escalation Date...
let v_today	=	num(today());
trace v_today	=	$(v_today);

let v_today_add_30	=	$(v_today)+30;
trace v_today_add_30;


Calendar_Issue_Escalation_Date:
load distinct Esclation_Dt
	,if(Esclation_Dt>=addmonths($(v_today),-1) and Esclation_Dt<=$(v_today)
    	,1,0) as Current_Full_Month_Escalation_Flag
resident [IC Issue];

[Map URL]:
LOAD
"Map URL"
FROM [$(v_RA_QVD_Global_Connection)/RA_Map_Background.qvd]
(qvd);


///$tab Colors
set v_Color_SE_Dark_Green = rgb(0,118,38);
set v_Color_SE_Spruce_Green = rgb(0,149,48); // AKA SE Logo Green
set v_Color_SE_Medium_Green = rgb(50,173,60);
set v_Color_SE_Life_Green = rgb(61,205,88);
