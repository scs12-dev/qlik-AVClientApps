set v_Color_SE_Super_Dark_Grey = rgb(80,85,89);
set v_Color_SE_Dark_Grey = rgb(98,100,105);
set v_Color_SE_Medium_Grey = rgb(159,160,164);
set v_Color_SE_Light_Grey = rgb(203,203,203);
set v_Color_SE_Super_Light_Grey = rgb(230,230,230);

Set v_Issue_Type_Colors = "pick(1+match([Issue Type], 'Other','More Info Required','Invalid Login Details','Non Cooperative',
'No Account Number', 'Invoice not Available', 'LOA Issues','Charge Per Invoice', 'Website Not Accessible', 'Non Responsive' ), 
rgb(210,210,210), v_Color_SE_Honeysuckle_Orange, v_Color_SE_Fuschia_Red, 
 v_Color_SE_Sunflower_Yellow, v_Color_SE_Life_Green, v_Color_SE_Seeding_Green, v_Color_SE_Light_Grey,v_Color_SE_Sky_Blue, v_Color_SE_Red,v_Color_SE_Dark_Green, v_Color_SE_Dark_Sky_Blue)";
 

///$tab Custom Reporting
Collection_Overview_Custom_Dim:
load * inline [
%co_dim, %co_dim_id
Division,a
Country,b
Service,d
Vendor,e
Alternate Account Number,g
Invoice Source,h
Billing Cycle,i];

set v_Co_Detail		=	0;

// date:
// load date(date#(44803,'YYYY-MM-DD'),'DD MMM YYYY') as newdate
// ,date#(44803,'YYYY-MM-DD') as newdate2
// ,date('2022-08-30','DD MMM YYYY') as newdate3
// autogenerate (1);

set v_Last_12_Mth = "only(if(GetSelectedCount([Service Month])=12 and GetPossibleCount(Current_13_Flag)=1,0,1))";


//clean up
drop field %COB_Account_Id
	,Current_Full_Month_Flag
    ,Display_Account_Number
    ,Expected_Invoice_Frequency
    ,Expected_Invoice_Receive_Day
    ,Expected_Invoice_Receive_Lag_Month
    ,Invoice_Chase_Comment
    ,Invoice_Collection_Service_Start_Dt
    ,Is_Chase_Activated
    ,max_date
    ,min_date;


///$tab Debug Data Model
//	This section simply creates a qvd for us to more easily research issues. Creates a flat table of the most-used tables
//	Note that rows might be duplicated depending on key replication in other tables especially security and ic_issue.
//	Issue comments have been dropped.

//	are we creating this today?
if v_debug	=	1 then

//	qualify all non-key fields
qualify *;
unqualify %Account_Invoice_Collection_Month_Id
	,%Invoice_Collection_Account_Config_Id
    ,%Account_Id;
    
ic_month:
load * resident [IC Record Status];

ic_issue:
load * resident [IC Issue];

ic_acc_cfg:
load * resident [IC Account Config];

sgsasrch:
load min(%SECURITYROLE) as %SECURITYROLE,
    %Client_Hier_Id,
    Site,
    Division,
    State,
    Country,
    Location,
    %Account_Id,
    [Account Type],
    [Utility Account Number],
    [Supplier Account Number],
    [Account Number],
    Display_Account_Number,
	[Utility Name],
    [Supplier Name]
resident [Security Account]
group by %Client_Hier_Id,
    Site,
    Division,
    State,
    Country,
    Location,
    %Account_Id,
    [Account Type],
    [Utility Account Number],
    [Supplier Account Number],
    [Account Number],
    Display_Account_Number,
	[Utility Name],
    [Supplier Name];

unqualify *;

//	create flat file
IC_debug_datamodel:
noconcatenate
load * resident ic_month;
join load * resident ic_issue;
join load * resident ic_acc_cfg;
join load * resident sgsasrch;

//	removing the comment field as it is very text heavy and dramatically increases size of qvds.
drop field [ic_issue.Issue_Comment];

//	store to qvd
LOAD
    client_id
FROM [lib://RAExtractions/11661/GR_Extract_BP_Portfolio.qvd]
(qvd);

store IC_debug_datamodel into [lib://RAExtractions/$(v_FolderName)\IC_debug_datamodel.qvd](qvd);

//	destroy all evidence
drop table ic_month
	,ic_issue
    ,ic_acc_cfg
    ,sgsasrch
    ,IC_debug_datamodel;
    
endif;